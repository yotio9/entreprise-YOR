# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=shop.example.com
# Leave empty to use the existing local SQLite database.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=1

# Wave: fill only with values from the merchant account.
WAVE_MERCHANT_NUMBER=
WAVE_QR_IMAGE=
WAVE_PAYMENT_LINK_BASE=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SITE_URL=
BRAND_LOGO_URL=

# SMTP: keep credentials only in the private .env or deployment secret store.
EMAIL_BACKEND=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# Jumia agent. It is read-only and simulation-only; it never adds to cart or checks out.
JUMIA_AGENT_ENABLED=0
JUMIA_AGENT_MODE=simulation
JUMIA_AGENT_POLL_SECONDS=20
JUMIA_AGENT_MAX_ATTEMPTS=3
JUMIA_AGENT_TIMEOUT_SECONDS=30
JUMIA_BROWSER_HEADLESS=1
JUMIA_EXPECTED_CURRENCY=XOF

# Optional OpenAI-compatible remote Llama endpoint. Do not send customer data to it.
LLM_API_BASE_URL=
LLM_API_KEY=
LLAMA_MODEL=
LLM_TIMEOUT_SECONDS=20
